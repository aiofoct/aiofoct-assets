
.max-w-\[900px\] {
max-width: 100% !important;
}

/* Force Blogger's main content wrapper to stretch 100% width */
.post-body,
.main-inner,
.content-wrapper,
.page .post {
  max-width: 100% !important;
  width: 100% !important;
  padding-left: 0 !important;
  padding-right: 0 !important;
  margin-left: 0 !important;
  margin-right: 0 !important;
}
